# Shell environment variables take precedence over this file.
TRADERAI_PROVIDER=openai
# Optional: defaults are provided for the three named providers.
# TRADERAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# For an OpenAI-compatible service, set TRADERAI_PROVIDER=openai-compatible,
# TRADERAI_MODEL, TRADERAI_BASE_URL (ending in /v1 if required), and this key:
TRADERAI_API_KEY=
# TRADERAI_BASE_URL=https://example.com/v1
# Optional forex OHLC feed. Required only when selecting Twelve Data.
TWELVE_DATA_API_KEY=
# TRADERAI_DB_PATH=.traderai/workspace.db
